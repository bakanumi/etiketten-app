[Unit]
Description=Etiketten-App (Next.js)
After=network.target

[Service]
Type=simple
User=etiketten
Group=etiketten
WorkingDirectory=/opt/etiketten-app
Environment=NODE_ENV=production
Environment=ETIKETTEN_DATA_DIR=/var/lib/etiketten-app
# Node-Pfad ggf. anpassen (which node). Nur auf localhost hören: erreichbar ist die App nur über nginx.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
