[Unit]
Description=Etiketten-App (Next.js)
After=network.target

[Service]
Type=simple
User=etiketten
Group=etiketten
WorkingDirectory=/opt/etiketten-app
Environment=NODE_ENV=production
Environment=ETIKETTEN_DATA_DIR=/var/lib/etiketten-app
# Enthält ETIKETTEN_PASSWORD=... (Passwortschutz). Ohne Bindestrich: fehlt die Datei, startet der
# Dienst nicht - statt die App versehentlich ungeschützt zu starten.
EnvironmentFile=/etc/etiketten-app.env
# Node-Pfad ggf. anpassen (which node). Nur auf localhost hören: erreichbar ist die App nur über nginx.
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
Restart=always
RestartSec=5
# Schutz vor Ausreißern: ein hängender Export darf nicht den ganzen Server (Makerspace Manager, ECO)
# belasten. Node bricht bei 512 MB Heap ab, systemd begrenzt den Dienst hart auf 768 MB.
Environment=NODE_OPTIONS=--max-old-space-size=512
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
